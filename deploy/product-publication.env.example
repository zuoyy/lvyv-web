# This file contains deployment paths, not usable credentials. Install as mode 0600.
LVYV_PUBLICATION_API_BASE=http://127.0.0.1:8088/web-api
# Must match backend LVYV_PRODUCT_PUBLICATION_WORKER_SECRET; minimum 32 characters.
LVYV_PUBLICATION_KEY=
NUXT_CONTENT_API_BASE=http://127.0.0.1:8088/web-api
LVYV_PRODUCT_SOURCE=/srv/lvyv-web/source/current
LVYV_STATIC_LINK=/srv/lvyv-web/public
LVYV_RELEASES_DIR=/srv/lvyv-web/releases
LVYV_PUBLICATION_STATE=/var/lib/lvyv-publication
LVYV_SITE_LOCK=/run/lock/lvyv-site/publish.lock
# Comma-separated stable public image origins, e.g. https://assets.example.com
LVYV_PUBLIC_ASSET_ORIGINS=
